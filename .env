# Default simulator backend for the cl SDK.
#
# cl/__init__.py calls load_dotenv() on import, so these take effect for any
# script run from the repo root with no code change. The SDK's built-in
# RandomDataSource emits random spikes and ignores stimulation; the LIF source
# responds to neurons.stim(). See src/organoid_simulator/README.md.
#
# This file is committed deliberately and must never hold secrets or tokens.
#
# Override for a single run by exporting CL_SDK_DATA_SOURCE, or in code with
# cl.sim.set_simulator_data_source(...), which takes precedence over both.

CL_SDK_DATA_SOURCE=organoid_simulator.lif_data_source:make_lif_source
CL_SDK_DATA_SOURCE_CONFIG={"random_seed": 42}
