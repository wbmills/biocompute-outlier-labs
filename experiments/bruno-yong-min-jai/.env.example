# Nothing loads this file automatically. To use it: cp .env.example .env && set -a && . ./.env && set +a
# Data source: reactive_sim | sdk_random | replay | cl_sdk_sim | live_cl1
# Tonight: cl-sdk simulator only, no living neurons. Default cl_sdk_sim (needs cl-sdk, Python >= 3.12);
# fallback reactive_sim (same tissue model without cl-sdk).
NEUROHEAR_SOURCE=cl_sdk_sim
# NEUROHEAR_SOURCE=reactive_sim
NEUROHEAR_SEED=123
NEUROHEAR_PORT=8000
NEUROHEAR_RUNS=runs
# Pause between trials so the raster is watchable (seconds)
NEUROHEAR_TRIAL_PAUSE_S=0.03
# Replay: path to a run folder or trials.jsonl
# NEUROHEAR_REPLAY=runs/<run_id>
# LIVE HARDWARE ONLY. Both are required, plus operator approval in the API.
# LIVE_STIM_ENABLED=true
# OPERATOR_LIMITS=operator_limits.json
